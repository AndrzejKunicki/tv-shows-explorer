{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,

    /* Node runs the .ts files directly (type stripping): no build step, only type checking */
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src"],
  /* Tests are type-checked by tsconfig.test.json, which adds the global Vitest API */
  "exclude": ["src/**/*.test.ts"]
}
