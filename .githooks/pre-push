#!/bin/sh
# Blocks direct pushes to main and pushes containing Polish text.
# All rules/docs must be translated to Russian before pushing.

# Polish diacritics: A, C, E, L, N, O, S, Z, Z (upper + lower case)
POLISH='[\x{0104}\x{0105}\x{0106}\x{0107}\x{0118}\x{0119}\x{0141}\x{0142}\x{0143}\x{0144}\x{00D3}\x{00F3}\x{015A}\x{015B}\x{0179}\x{017A}\x{017B}\x{017C}]'
ZERO=0000000000000000000000000000000000000000

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # branch deletion

  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing directly to 'main' is not allowed. Open a Pull Request instead." >&2
    status=1
    continue
  fi

  matches=$(git grep -I -n -P "$POLISH" "$local_sha" -- . 2>/dev/null)
  if [ -n "$matches" ]; then
    echo "pre-push: Polish text found in $local_ref:" >&2
    echo "$matches" | sed "s/^$local_sha://" | head -20 >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "Push aborted: fix the problems above (translate Polish text to Russian, push to a task branch)." >&2
fi
exit $status
